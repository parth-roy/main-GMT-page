{
  "name": "gomytruck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node generate-sitemap.js && npm run build:client && npm run build:ssr && npm run prerender && npm run validate:seo",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
